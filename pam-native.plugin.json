{
    "$schema": "vendor/pushinbr/pam-native/resources/pam-native.plugin.schema.json",
    "version": 1,
    "protocol": 1,
    "pamNative": {
        "minimum": "1.46.0",
        "maximumExclusive": "2.0.0"
    },
    "php": {
        "provider": "Pam\\Native\\Contacts\\ContactsPluginProvider"
    },
    "android": {
        "namespace": "dev.pam.contacts",
        "minSdk": 26,
        "permissions": [
            "android.permission.READ_CONTACTS"
        ],
        "sourceDirs": [
            "android/src/main/kotlin"
        ]
    },
    "ios": {
        "minimumVersion": "15.0",
        "sourceDirs": [
            "ios/Sources"
        ],
        "frameworks": [
            "Contacts",
            "ContactsUI",
            "MessageUI"
        ],
        "usageDescriptions": {
            "NSContactsUsageDescription": "Find people you know."
        }
    },
    "idl": "pam-native.idl.json",
    "modules": [
        {
            "name": "contacts",
            "class": "dev.pam.contacts.ContactsModule",
            "iosClass": "ContactsModule"
        },
        {
            "name": "sms",
            "class": "dev.pam.contacts.SmsModule",
            "iosClass": "SmsModule"
        }
    ],
    "views": []
}
